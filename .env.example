# Port the Fastify backend listens on.
BACKEND_PORT=3000

ORIGIN=http://localhost:5173

# Origins where the backend mounts its two API surfaces:
#   BFF - internal API (auth + tRPC) consumed by the web app.
#   REST - public API consumed by external SDKs and CLI clients.
# Required unless STANDALONE=true (see below).
BFF_API_ORIGIN=http://localhost:3000/_
REST_API_ORIGIN=http://localhost:3000/api

# All-in-one (standalone) deployment: the backend serves the web app from
# ./public and exposes both APIs under a single origin. When STANDALONE=true,
# BFF_API_ORIGIN and REST_API_ORIGIN are derived from STANDALONE_ORIGIN as
# `${STANDALONE_ORIGIN}/_` and `${STANDALONE_ORIGIN}/api` respectively.
# STANDALONE=true
# STANDALONE_ORIGIN=http://localhost:3000

# Postgres connection string.
DATABASE_URL=postgres://user:password@localhost:5432/featurectrl

# Secret used by Better Auth to sign sessions. Must be a 32-byte random value
# Generate using: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-byte-random-secret

# Optional OAuth providers — set both ID and SECRET for a provider to enable it.
# When unset, the provider is hidden from the login page.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
